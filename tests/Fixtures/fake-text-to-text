#!/usr/bin/env bash
# Stands in for the compiled text-to-text runner: echoes its arguments on stderr and answers with a two-line
# text quoting the prompt. The prompt "fail" makes it fail.
echo "args: $*" >&2

prompt=""
while [ $# -gt 0 ]; do
    case "$1" in
        --prompt) prompt="$2"; shift 2 ;;
        *) shift ;;
    esac
done

if [ "$prompt" = "fail" ]; then
    echo "[text-to-text] Error: RuntimeError: out of memory" >&2
    exit 1
fi

echo "noise a library printed to stdout"
printf '{"text": "You said: %s\\nThat is all."}\n' "$prompt"
