#!/usr/bin/env bash
# Stands in for the compiled text-to-speech runner: echoes its arguments on stderr and reports the --output path
# as written. The text "fail" makes it fail.
echo "args: $*" >&2

output=""
text=""
while [ $# -gt 0 ]; do
    case "$1" in
        --output) output="$2"; shift 2 ;;
        --text) text="$2"; shift 2 ;;
        *) shift ;;
    esac
done

if [ "$text" = "fail" ]; then
    echo "[text-to-speech] Error: RuntimeError: the model produced no audio for this text" >&2
    exit 1
fi

echo "noise a library printed to stdout"
printf '{"output": "%s", "seconds": 2.5}\n' "$output"
