#!/usr/bin/env bash
# Stands in for the compiled puller binary: echoes its arguments and API key on stderr and reports every model as
# pulled, except:
#   broken/model   fails
#   gated/model    is denied as gated
#   private/model  is denied as not found unless an API key is given
#   outdated/model exits like an old puller that required an API key for every model
echo "args: $*" >&2
echo "api key: ${HUGGING_FACE_API_KEY:-none}" >&2

dir=""
skipped_files=2
skipped_bytes=471859200
while [ $# -gt 0 ]; do
    case "$1" in
        --dir) dir="$2"; shift 2 ;;
        --all) skipped_files=0; skipped_bytes=0; shift ;;
        --revision) shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done

status=0
for model in "$@"; do
    case "$model" in
        broken/model)
            echo "[puller] Error: failed to pull $model" >&2
            status=1
            ;;
        gated/model)
            echo "[puller] Error: $model is gated" >&2
            printf '{"model": "%s", "error": "gated"}\n' "$model"
            status=1
            ;;
        private/model)
            if [ -z "$HUGGING_FACE_API_KEY" ]; then
                echo "[puller] Error: $model was not found" >&2
                printf '{"model": "%s", "error": "not_found"}\n' "$model"
                status=1
            else
                printf '{"model": "%s", "path": "%s/%s", "skipped_files": %s, "skipped_bytes": %s}\n' "$model" "$dir" "$model" "$skipped_files" "$skipped_bytes"
            fi
            ;;
        outdated/model)
            if [ -z "$HUGGING_FACE_API_KEY" ]; then
                echo "[puller] Error: environment variable HUGGING_FACE_API_KEY is not set." >&2
                exit 3
            fi
            printf '{"model": "%s", "path": "%s/%s", "skipped_files": %s, "skipped_bytes": %s}\n' "$model" "$dir" "$model" "$skipped_files" "$skipped_bytes"
            ;;
        *)
            printf '{"model": "%s", "path": "%s/%s", "skipped_files": %s, "skipped_bytes": %s}\n' "$model" "$dir" "$model" "$skipped_files" "$skipped_bytes"
            ;;
    esac
done

exit $status
