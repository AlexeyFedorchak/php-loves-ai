#!/usr/bin/env bash
# Stands in for the compiled image-to-text runner: echoes its arguments on stderr and answers with a text naming the
# image and the prompt. The prompt "fail" makes it fail.
echo "args: $*" >&2

image=""
prompt="(none)"
while [ $# -gt 0 ]; do
    case "$1" in
        --image) image="$2"; shift 2 ;;
        --prompt) prompt="$2"; shift 2 ;;
        *) shift ;;
    esac
done

if [ "$prompt" = "fail" ]; then
    echo "[image-to-text] Error: OSError: cannot identify image file" >&2
    exit 1
fi

echo "noise a library printed to stdout"
printf '{"text": "Looked at %s\\nPrompt: %s"}\n' "$(basename "$image")" "$prompt"
