#!/usr/bin/env bash
# Stands in for the compiled text-to-video runner: echoes its arguments on stderr and reports the --output path
# as written. The prompt "fail" makes it fail.
echo "args: $*" >&2

output=""
prompt=""
while [ $# -gt 0 ]; do
    case "$1" in
        --output) output="$2"; shift 2 ;;
        --prompt) prompt="$2"; shift 2 ;;
        *) shift ;;
    esac
done

if [ "$prompt" = "fail" ]; then
    echo "[text-to-video] Error: RuntimeError: out of memory while generating frames" >&2
    exit 1
fi

echo "noise a library printed to stdout"
printf '{"output": "%s", "frames": 16, "width": 256, "height": 256, "fps": 8}\n' "$output"
