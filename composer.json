{
    "name": "php-loves-ai/php-loves-ai",
    "description": "Run small Hugging Face AI models locally from PHP via prebuilt standalone binaries — no Python installation required.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ai",
        "llm",
        "machine-learning",
        "hugging-face",
        "inference",
        "local"
    ],
    "authors": [
        {
            "name": "Oleksiy Fedorchak",
            "email": "ofedorchak68@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-openssl": "Needed by `setup` to download binaries over HTTPS (enabled in most PHP builds)"
    },
    "bin": [
        "bin/setup",
        "bin/pull",
        "bin/text-to-image"
    ],
    "autoload": {
        "psr-4": {
            "PhpLovesAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpLovesAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
