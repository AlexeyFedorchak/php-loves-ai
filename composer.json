{
    "name": "php-loves-ai/multimodal-ai-runner",
    "description": "Run AI models locally from PHP: text-to-image, image-to-image, text-to-text, image-to-text, speech-to-text, text-to-speech, text-to-video and image-to-video.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ai",
        "llm",
        "machine-learning",
        "hugging-face",
        "inference",
        "local",
        "multimodal",
        "text-to-image",
        "speech-to-text",
        "text-to-speech",
        "whisper"
    ],
    "authors": [
        {
            "name": "Oleksiy Fedorchak",
            "email": "ofedorchak68@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-openssl": "Needed by `setup` to download binaries over HTTPS (enabled in most PHP builds)"
    },
    "bin": [
        "bin/loves-ai"
    ],
    "autoload": {
        "psr-4": {
            "PhpLovesAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpLovesAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
